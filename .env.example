# Copy this file to .env and fill in your own Stripe TEST-mode secret key.
# Find it at https://dashboard.stripe.com/test/apikeys (starts with sk_test_).
# Never put a live (sk_live_) key here, and never commit .env — it's gitignored.
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# Optional: change the local port (defaults to 4242).
PORT=4242
